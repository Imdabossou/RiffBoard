{
  "name": "riffboard-browser-tests",
  "version": "0.3.0",
  "description": "Frontend unit tests (node --test) and Playwright browser tests for RiffBoard.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:js": "node --test tests/js/*.test.js 'tests/plugins/*/js/*.test.js' plugins/note_detect/test/*.test.js",
    "install:playwright": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "tailwindcss": "^3.4.19"
  }
}
